    "Cramers_V": "sqrt(chi2/[N*min(r-1,c-1)]), uncorrected",
    "rank_epsilon_squared": "H/(N-1), rank variance association, upward finite-sample bias",
    "eta_squared": "SS_between/SS_total for ANOVA"
  },
  "categorical_posthoc": "Two-sided proportion difference for each urgency between exposure-category pairs; Fisher exact if expected or observed counts below five",
  "sparse_omnibus": "Fixed-margin conditional Monte Carlo Pearson statistic, 19999 resamples, seed 42; finite MC resolution and standard error reported",
  "independence": "Full-request p-values are nominal and not cluster-adjusted, including KW; patient sensitivity removes repeated patients but not all potential dependence or confounding",
  "p_value_underflow": "A numerical p=0 denotes floating-point underflow, not a literally zero probability",
  "limitations": "Exploratory after full-cohort EDA; no causal inference; no clinical/practical significance threshold prespecified; one sensitivity sample is not a cluster-robust analysis",
